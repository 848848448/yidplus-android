<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YidPlus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/bar_default</item>
        <item name="android:navigationBarColor">@color/bar_default</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.YidPlus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.YidPlus</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/bar_default</item>
        <item name="android:navigationBarColor">@color/bar_default</item>
    </style>

    <style name="ThemeOverlay.YidPlus.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="buttonBarPositiveButtonStyle">@style/YidPlus.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/YidPlus.DialogButton</item>
    </style>
    <style name="YidPlus.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="YidPlus.DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="ThemeOverlay.YidPlus.TopBar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="actionBarItemBackground">@drawable/toolbar_btn_bg</item>
        <item name="selectableItemBackgroundBorderless">@drawable/toolbar_btn_bg</item>
    </style>
    <style name="YidPlus.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#2ED4AF37</item>
        <item name="android:width">52dp</item>
        <item name="android:height">26dp</item>
    </style>
    <style name="YidPlus.NavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/nav_label</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
