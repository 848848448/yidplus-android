<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YidPlus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/bar_default</item>
        <item name="android:navigationBarColor">@color/bar_default</item>
    </style>

    <style name="Theme.YidPlus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.YidPlus</item>
    </style>

    <style name="ThemeOverlay.YidPlus.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="buttonBarPositiveButtonStyle">@style/YidPlus.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/YidPlus.DialogButton</item>
    </style>
    <style name="YidPlus.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="YidPlus.DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
